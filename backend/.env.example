# Template for every environment, checked into Git. It lists every variable the backend reads
# (src/platform/settings.ts), all commented out. The backend never reads this file itself.
#
# - Local development: copy it to .env.local and uncomment only the variables you want to change.
#   Everything left commented keeps the value from .env.development or the coded default.
# - A deployment (the Render secret file /etc/secrets/.env, a docker-compose .env, or container
#   environment variables): no .env.development exists there, so set at least every variable
#   marked [required]. A deployment also wants FRONTEND_BASE_URL, and usually email and real
#   image generation.
#
# Never set a variable to an empty string, and keep real keys out of Git.
# See docs/dev/backend/getting-started/running-the-development-server.md and full-stack-image.md.

# --- Server --------------------------------------------------------------------------------------
# PORT=8080
# true only behind exactly one trusted reverse proxy (Render), see conventions/rate-limiting.md.
# RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- Database ------------------------------------------------------------------------------------
# [required] NAME, USERNAME, and PASSWORD; .env.development sets them for the local container.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=voenix_ts
# DATABASE_USERNAME=voenix
# DATABASE_PASSWORD=voenix
# DATABASE_SEARCH_PATH=voenix
# disable, require, verify-ca, or verify-full; require for a managed database.
# DATABASE_SSL_MODE=disable
# DATABASE_MAXIMUM_POOL_SIZE=100

# --- Authentication ------------------------------------------------------------------------------
# [required] At least 32 UTF-8 bytes; derives every cookie key, so changing it signs everyone out.
# .env.development sets a development value. Generate one with: openssl rand -base64 48
# AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes

# --- Frontend ------------------------------------------------------------------------------------
# Where every mailed link and the Mollie return point; HTTPS outside localhost. A deployment sets
# its public address, for example https://shop.example.com.
# FRONTEND_BASE_URL=http://localhost:5173
# The built frontend to serve; the full-stack image sets it, the Vite dev server needs none.
# FRONTEND_DIST_PATH=/app/frontend/dist

# --- Storage -------------------------------------------------------------------------------------
# Relative paths resolve against the working directory of the backend process (backend/ when
# started with bun run dev, here or in the repository root). Point the image roots at an existing
# image store, for example the catalog images imported from v1, so the image file names in the
# database find their files. The three image roots must not overlap.
# IMAGE_PUBLIC_ROOT=/absolute/path/to/storage/public/images
# IMAGE_PRIVATE_ROOT=/absolute/path/to/storage/private/images
# IMAGE_CACHE_ROOT=/absolute/path/to/storage/cache
# PRODUCTION_ARTIFACT_ROOT=/absolute/path/to/storage/production

# --- Payments (Mollie) ---------------------------------------------------------------------------
# [required] .env.development sets placeholders that pass the startup checks. Locally, a Mollie
# test key and an ngrok URL; the webhook URL must be HTTPS and end in the secret (16 characters
# or more). A test system uses a test_ key, only production a live_ key.
# MOLLIE_API_KEY=test_replace-me
# MOLLIE_WEBHOOK_URL=https://replace-me.ngrok.app/api/payments/webhook/replace-with-16-chars
# MOLLIE_WEBHOOK_SECRET=replace-with-16-chars

# --- Image generation (fal.ai, paid) -------------------------------------------------------------
# The default is false, and then the key is required; .env.development sets dummy mode true.
# GENERATOR_DUMMY_MODE=false
# GENERATOR_API_KEY=replace-me

# --- Email (Sweego) ------------------------------------------------------------------------------
# Off by default; when true, the key and the sender address are required.
# EMAIL_ENABLED=true
# EMAIL_API_KEY=replace-me
# EMAIL_FROM_EMAIL=shop@example.com
# EMAIL_FROM_NAME=Voenix Shop
# EMAIL_POLL_INTERVAL_MINUTES=5

# --- Operations alerts ---------------------------------------------------------------------------
# Where the operations alert and the SPOD ops alert go; unset, the findings are only logged.
# Required once PRODUCTION_SPOD_WEBHOOK_SECRET is set.
# OPERATIONS_ALERT_EMAIL=you@example.com

# --- Print on demand (SPOD) ----------------------------------------------------------------------
# The secret needs 32 characters or more, and OPERATIONS_ALERT_EMAIL must be set with it.
# PRODUCTION_SPOD_WEBHOOK_SECRET=replace-with-at-least-32-characters
