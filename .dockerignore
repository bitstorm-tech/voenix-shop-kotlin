# Build context of the repository-root Dockerfile and of backend/Dockerfile
# (both are built from the repository root). Keep out everything the image must
# not carry: per-developer secrets, the checked-in development values (a
# deployment is configured through environment variables only, and a missing
# one must fail the start instead of falling back to a development default),
# local build output, dependencies the build stages install themselves, and
# local runtime data.
.git/
.idea/
.DS_Store
*.iml
docs/
storage/
backend/.env.development
backend/.env.local
backend/.env.example
node_modules/
backend/node_modules/
backend/data/
frontend/node_modules/
frontend/dist/
frontend/output/
frontend/tmp/
