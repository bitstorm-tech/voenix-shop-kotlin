# Template for backend-ts/.env.local, checked into Git. The backend never reads this file: copy
# it to .env.local and uncomment only the variables you want to change. Everything left commented
# keeps the value from .env.development or the default coded in src/platform/settings.ts; never
# set a variable to an empty string. .env.local is ignored by Git, so real keys belong there.
# See docs/dev/backend-ts/getting-started/running-the-development-server.md.

# --- Storage -------------------------------------------------------------------------------------
# Relative paths resolve against the working directory of the backend process (backend-ts/ when
# started with bun run dev, here or in the repository root). Point the image roots at an existing
# image store, for example the catalog images imported from v1, so the image file names in the
# database find their files. The three image roots must not overlap.
# IMAGE_PUBLIC_ROOT=/absolute/path/to/storage/public/images
# IMAGE_PRIVATE_ROOT=/absolute/path/to/storage/private/images
# IMAGE_CACHE_ROOT=/absolute/path/to/storage/cache
# PRODUCTION_ARTIFACT_ROOT=/absolute/path/to/storage/production

# --- Database ------------------------------------------------------------------------------------
# Only for a different database than the local container.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=voenix_ts
# DATABASE_USERNAME=voenix
# DATABASE_PASSWORD=voenix

# --- Payments (Mollie) ---------------------------------------------------------------------------
# A Mollie test key and an ngrok URL; the webhook URL must end in the secret (16 characters or more).
# MOLLIE_API_KEY=test_replace-me
# MOLLIE_WEBHOOK_URL=https://replace-me.ngrok.app/api/payments/webhook/replace-with-16-chars
# MOLLIE_WEBHOOK_SECRET=replace-with-16-chars

# --- Image generation (fal.ai, paid) -------------------------------------------------------------
# GENERATOR_DUMMY_MODE=false
# GENERATOR_API_KEY=replace-me

# --- Email (Sweego) ------------------------------------------------------------------------------
# EMAIL_ENABLED=true
# EMAIL_API_KEY=replace-me
# EMAIL_FROM_EMAIL=shop@example.com

# --- Operations alerts ---------------------------------------------------------------------------
# Where the operations alert and the SPOD ops alert go; unset, the findings are only logged.
# Required once PRODUCTION_SPOD_WEBHOOK_SECRET is set.
# OPERATIONS_ALERT_EMAIL=you@example.com

# --- Print on demand (SPOD) ----------------------------------------------------------------------
# The secret needs 32 characters or more, and OPERATIONS_ALERT_EMAIL must be set with it.
# PRODUCTION_SPOD_WEBHOOK_SECRET=replace-with-at-least-32-characters
