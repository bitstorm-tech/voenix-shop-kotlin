# Shared development values, checked into Git. The backend loads this file first and then
# .env.local (ignored by Git, optional), and a variable that is already set in the real
# environment wins over both. A variable that is absent here keeps the default coded in
# src/platform/settings.ts; never set a variable to an empty string.
#
# The values are development-only: the database password opens the local container, the
# session secret signs cookies on your own machine, and the Mollie values are placeholders
# that pass the startup checks. Real keys (a Mollie test key, a fal.ai or Sweego key)
# belong in .env.local, never here.
# See docs/dev/backend-ts/getting-started/running-the-development-server.md.

DATABASE_NAME=voenix_ts
DATABASE_USERNAME=voenix
DATABASE_PASSWORD=voenix

AUTH_SESSION_SECRET=development-only-session-secret-not-for-production

FRONTEND_BASE_URL=http://localhost:5173

# true = the generator answers with the uploaded image and never calls the paid fal.ai API.
# For real generation, set GENERATOR_DUMMY_MODE=false and GENERATOR_API_KEY in .env.local.
GENERATOR_DUMMY_MODE=true

# Placeholders that pass the startup checks. Starting a payment fails at the Mollie API; to
# test payments, set a real test_ key and an ngrok webhook URL in .env.local.
MOLLIE_API_KEY=test_development-placeholder
MOLLIE_REDIRECT_URL=http://localhost:5173/checkout
MOLLIE_WEBHOOK_URL=https://localhost/api/payments/webhook/development-webhook-secret
MOLLIE_WEBHOOK_SECRET=development-webhook-secret
